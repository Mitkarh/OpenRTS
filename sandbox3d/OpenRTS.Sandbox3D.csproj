<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/OpenRTS.Content/OpenRTS.Content.csproj" />
    <Compile Include="../src/OpenRTS.Godot/Controls/PlanarCamera.cs;../src/OpenRTS.Godot/Controls/SelectionState.cs" Link="Controls/%(Filename)%(Extension)" />
    <Compile Include="../src/OpenRTS.Godot/Rendering/ContactDisplayStyle.cs;../src/OpenRTS.Godot/Rendering/TerrainSurface.cs" Link="Rendering/ContactDisplayStyle.cs;../src/OpenRTS.Godot/Rendering/TerrainSurface.cs" />
    <Compile Remove="Controls/Shared/RtsOverlay.cs" />
    <Compile Include="Controls/Shared/RtsOverlay.cs" />
  </ItemGroup>
  <!-- Godot registers the resource path of the Control script for exports. -->
  <Target Name="CopySharedOverlay" BeforeTargets="PrepareForBuild">
    <Copy SourceFiles="../src/OpenRTS.Godot/Controls/RtsOverlay.cs" DestinationFolder="Controls/Shared" SkipUnchangedFiles="true" />
  </Target>
</Project>
