[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://Sandbox3D.cs" id="1"]

[sub_resource type="Shader" id="Grid"]
code = "shader_type spatial;
render_mode cull_disabled;

varying vec2 ground;

void vertex() {
    ground = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xz;
}

void fragment() {
    vec2 cell_edge = abs(fract(ground + 0.5) - 0.5);
    vec2 pixels = cell_edge / max(fwidth(ground), vec2(0.001));
    float line = 1.0 - smoothstep(0.0, 1.0, min(pixels.x, pixels.y));
    ALBEDO = COLOR.rgb + vec3(0.045) * line;
    ROUGHNESS = 1.0;
}"

[sub_resource type="ShaderMaterial" id="GroundMaterial"]
shader = SubResource("Grid")

[sub_resource type="Environment" id="Lighting"]
